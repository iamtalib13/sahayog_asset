 "query": "SELECT \n    pr.date,\n    pr.name,\n    pr.emp_name,\n    pr.select_department,\n    pr.status,\n    pr.item_purpose,\n    pri.asset_name,\n    pri.quantity\nFROM \n    `tabPurchase Requisition` pr\nLEFT JOIN \n    `tabAsset List` pri\nON \n    pri.parent = pr.name\nWHERE \n    pr.status IN ('Dispatched', 'Received');",
